<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>Eltele.GeoJson</PackageId>
    <Authors>Fredrik Stock</Authors>
    <Company>Eltele AS</Company>
    <Description>RFC 7946 GeoJSON objects modelled as C# 15 unions, with System.Text.Json converters that need no configuration.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>geojson;rfc7946;gis;union-types</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
